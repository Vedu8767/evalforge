# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://evalforge:evalforge_dev@localhost:5432/evalforge
DATABASE_URL_SYNC=postgresql://evalforge:evalforge_dev@localhost:5432/evalforge

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-make-this-64-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── Encryption ──────────────────────────────────────────────────────
ENCRYPTION_KEY=change-me-32-bytes-hex-in-prod!!

# ─── AI Provider — pick ONE ──────────────────────────────────────────
# Option 1: Ollama (FREE — runs locally, no internet needed)
# Install: https://ollama.com  then run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Option 2: OpenAI (leave empty if using Ollama)
OPENAI_API_KEY=

# Option 3: Anthropic (leave empty if using Ollama)
ANTHROPIC_API_KEY=

# ─── Billing (optional — Stripe) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ─── Email (optional — Resend) ───────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@evalforge.app

# ─── App ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO
SENTRY_DSN=
